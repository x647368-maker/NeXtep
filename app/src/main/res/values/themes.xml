<resources>
    <style name="Theme.NeXtep" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_atomic_workbench</item>
        <!-- Ported from PR #1 onto the recovered 0.8.0 source. -->
        <item name="android:windowSplashScreenBackground">@color/stage_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/stage_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="colorPrimary">#1F5CDE</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E5EDFF</item>
        <item name="colorOnPrimaryContainer">#163777</item>
        <item name="colorSecondary">#1F5CDE</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorAccent">#1F5CDE</item>
        <item name="colorSecondaryContainer">#E5EDFF</item>
        <item name="colorOnSecondaryContainer">#163777</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#202024</item>
        <item name="colorSurfaceVariant">#EAEAEF</item>
        <item name="colorOnSurfaceVariant">#606067</item>
        <item name="colorOutline">#80808A</item>
        <item name="colorOutlineVariant">#DEDEE4</item>
        <item name="android:colorBackground">@color/stage_background</item>
        <item name="android:statusBarColor">@color/stage_background</item>
        <item name="android:navigationBarColor">@color/stage_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <!-- Preserve the no-window launcher trampoline and its stable alias identities. -->
    <style name="Theme.StageLauncherEntry" parent="android:style/Theme.NoDisplay">
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_atomic_workbench</item>
        <item name="android:windowSplashScreenBackground">@color/stage_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
